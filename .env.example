# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# El archivo .env NO se sube al repositorio.
# En staging y prod estas variables se inyectan desde el entorno del servidor, no desde un archivo.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autobot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contrasena

# --- Perfil activo: local | staging | prod (opcional, por defecto local) ---
# SPRING_PROFILES_ACTIVE=local

# --- Respaldos (scripts/backup.sh y scripts/restore.sh) ---
# Si no tienes pg_dump instalado, usa el contenedor de Docker:
POSTGRES_CONTAINER=autobot_postgres
S3_BUCKET=nombre-de-tu-bucket
S3_PREFIX=backups
# UPLOADS_DIR=./uploads
# Las credenciales de AWS NO van aquí: usa `aws configure` o variables del entorno.

# --- JWT (autenticación) ---
# Obligatorio, mínimo 32 bytes. Genera uno con: openssl rand -base64 48
# Cada entorno usa el suyo; cambiarlo invalida todos los tokens emitidos.
JWT_SECRET=cambia_esto
# JWT_EXPIRATION_MINUTES=60
# JWT_ISSUER=autobot-backend
